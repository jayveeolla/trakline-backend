# Set these on the backend host (or copy to server/.env for local backend-only use).
NODE_ENV=production
PORT=4000
DB_HOST=your-database-host
DB_PORT=3306
DB_USER=your-database-user
DB_PASSWORD=replace-with-database-password
DB_NAME=shuttle_tracking
JWT_SECRET=replace-with-a-long-random-secret
# Exact frontend origin, with no trailing slash or path.
WEB_ORIGIN=https://your-frontend.example.com

# Only needed when intentionally creating/seeding a new database.
ADMIN_EMAIL=admin@trackline.local
ADMIN_PASSWORD=replace-with-a-strong-password
